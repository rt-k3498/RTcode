{
  "name": "r-console-ide",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "pnpm guide:build && tsc --noEmit && vite build",
    "guide:build": "node scripts/build-guide.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src/test --environment node && node --test scripts/rust-toolchain.test.mjs",
    "test:e2e": "playwright test",
    "tauri": "node scripts/tauri.mjs",
    "lint": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\" \"e2e/*.ts\" \"*.ts\" \"*.json\""
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "monaco-editor": "^0.55.1",
    "solid-js": "^1.9.11",
    "@fontsource/jetbrains-mono": "^5.2.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^24.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-solid": "^2.11.10",
    "vitest": "^4.0.18",
    "prettier": "^3.6.2"
  },
  "packageManager": "pnpm@11.18.0"
}
